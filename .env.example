# ---------------------------------------------------------------------------
# ZeroTrustX configuration. Copy to `.env` (repo root, used by docker compose)
# and/or `backend/.env` (used when running the API directly). NEVER commit .env.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development

# PostgreSQL (docker compose builds DATABASE_URL from these)
POSTGRES_DB=zerotrustx
POSTGRES_USER=zerotrustx
POSTGRES_PASSWORD=zerotrustx_dev
# Used when running the backend outside docker
DATABASE_URL=postgresql+psycopg://zerotrustx:zerotrustx_dev@localhost:5432/zerotrustx

# Secrets. In development, built-in insecure defaults are used when these are unset.
# The API REFUSES TO START with the defaults when APP_ENV=production.
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY=
# Generate:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# MFA_ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Browser security
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Set COOKIE_SECURE=true when served over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
FRONTEND_URL=http://localhost:5173

# Abuse protection (in-process limiter)
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Development helpers - must be false in production.
# EXPOSE_DEV_RESET_TOKENS returns the password-reset link in the API response (no email provider is configured).
EXPOSE_DEV_RESET_TOKENS=false
# Docker entrypoint loads demo data when true (refused when APP_ENV=production)
SEED_DEMO_DATA=true

# Security Assistant provider (only "local" - deterministic rules - is implemented)
ASSISTANT_PROVIDER=local
